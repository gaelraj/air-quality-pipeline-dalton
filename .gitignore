.env
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/

# Generated data is ignored locally.
# GitHub Actions commits generated raw and clean files explicitly with git add -f.
data/raw/*
!data/raw/.gitkeep

data/clean/*
!data/clean/.gitkeep

*.log
logs/
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/
